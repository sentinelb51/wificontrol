#include <windows.h>
#include "resource.h"

/* CREATEPROCESS_MANIFEST_RESOURCE_ID, RT_MANIFEST */
1 24 "app.manifest"

/* Both windows are laid out in code at the monitor's DPI, so the templates
 * carry only the frame; every control is created and painted at runtime. */
IDD_MAIN DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "WiFi Control"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
END

IDD_DIAG DIALOGEX 0, 0, 400, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "WiFi Control - details"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
END

IDD_TUNE DIALOGEX 0, 0, 380, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Tuning"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
END
